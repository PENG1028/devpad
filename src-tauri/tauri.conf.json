{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevPad",
  "version": "0.7.0-dev.0",
  "mainBinaryName": "devpad",
  "identifier": "local.devpad.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevPad",
        "width": 1040,
        "height": 780,
        "minWidth": 400,
        "minHeight": 320,
        "dragDropEnabled": false,
        "decorations": false,
        "visible": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/local.devpad.desktop/attachments/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "startMenuFolder": "DevPad",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "license": "PolyForm-Noncommercial-1.0.0",
    "licenseFile": "../LICENSE",
    "resources": {
      "../NOTICE": "NOTICE",
      "../scripts/migrate-shortcuts.ps1": "migrate-shortcuts.ps1",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGNDc3NTYyOERCQjdCRjQKUldUMGU3dU5ZblZIanhQcllmeDloWS9EWUplcGVWUWVtSEVGSnQ0OW5URHFnOVRlckpWWWZuWGsK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
