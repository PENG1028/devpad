{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevPad",
  "version": "0.6.5",
  "identifier": "local.devpad.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevPad",
        "width": 1040,
        "height": 780,
        "minWidth": 400,
        "minHeight": 320,
        "dragDropEnabled": false,
        "decorations": false,
        "visible": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/local.devpad.desktop/attachments/**"
        ]
      }
    }
  },
  "bundle": {
    "active": false
  }
}
